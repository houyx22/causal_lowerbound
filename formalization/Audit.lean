  let mut checked := 0
  let env ← getEnv
  -- Share Lean's visited-dependency set across roots. This visits the same
  -- transitive kernel dependencies as collectAxioms on every root, once each.
  let mut auditState : CollectAxioms.State := {}
  for (name, info) in env.constants.toList do
    if ((`CausalLowerbound).isPrefixOf name && info.isTheorem) || definitions.contains name then
      let (_, next) := ((CollectAxioms.collect name).run env).run auditState
      auditState := next
      let unexpected := auditState.axioms.filter (fun ax => !allowed.contains ax)
      unless unexpected.isEmpty do
        throwError "Unexpected axioms in {name}: {unexpected}"
      checked := checked + 1
  logInfo m!"Axiom audit passed for {checked} theorem/definition roots. Only propext, Classical.choice, and Quot.sound are allowed."
